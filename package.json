{
  "name": "opensheets",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.34.7",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "eslint .",
    "coverage:api": "pnpm --filter @opensheets/compat coverage:api",
    "inventory": "pnpm --filter @opensheets/compat inventory",
    "generate": "pnpm --filter @opensheets/compat generate",
    "compare": "pnpm --filter @opensheets/compare dev",
    "test:compare": "pnpm --filter @opensheets/compare test:visual",
    "setup:compare": "PLAYWRIGHT_BROWSERS_PATH=.playwright-browsers playwright install chromium"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.0.0",
    "eslint": "^10.14.0",
    "jsdom": "^26.1.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^3.2.4"
  }
}
