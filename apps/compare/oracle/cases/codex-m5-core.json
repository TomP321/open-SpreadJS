    "steps": [
      {
        "$js": "GC.Spread.Sheets.InputMask.namedPattern('codexM5Phone','000-000')"
      },
      {
        "$js": "GC.Spread.Sheets.InputMask.namedPattern('codexM5Phone',null)"
      }
    ],
    "read": [
