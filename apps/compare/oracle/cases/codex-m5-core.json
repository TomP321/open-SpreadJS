      "js:sheet.getSparkline(0,2) ? [sheet.getSparkline(0,2).row,sheet.getSparkline(0,2).column,sheet.getSparkline(0,2).sparklineType(),sheet.getSparkline(0,2).dataOrientation(),sheet.getSparkline(0,2).data()] : null",
