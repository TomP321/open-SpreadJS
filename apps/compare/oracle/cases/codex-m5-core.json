  {
    "id": "codex-m5-sparkline-options",
    "steps": [
      {
        "$js": "sheet.setSparkline(4,2,new GC.Spread.Sheets.Range(0,0,4,1),0,1,new GC.Spread.Sheets.Sparklines.SparklineSetting({showMarkers:true,seriesColor:'red',displayXAxis:true,lineWeight:2}))"
      }
    ],
    "read": [
      "js:sheet.getSparkline(4,2) ? sheet.getSparkline(4,2).setting().options : null",
      "js:sheet.toJSON().sparklineGroups"
    ]
  },
  {
    "id": "codex-m5-sparkline-group",
    "steps": [
      {
        "$js": "sheet.setSparkline(4,2,new GC.Spread.Sheets.Range(0,0,4,1),0,0,new GC.Spread.Sheets.Sparklines.SparklineSetting());sheet.setSparkline(5,2,new GC.Spread.Sheets.Range(0,0,4,1),0,1,new GC.Spread.Sheets.Sparklines.SparklineSetting());sheet.groupSparkline([sheet.getSparkline(4,2),sheet.getSparkline(5,2)])"
      }
    ],
    "read": [
      "js:sheet.toJSON().sparklineGroups"
    ],
    "cells": {
      "A1": 1,
      "A2": 2
    }
  },
  {
    "id": "codex-m5-sparkline-remove",
    "steps": [
      {
        "$js": "sheet.setSparkline(0,2,'A1:A3',0,0,new GC.Spread.Sheets.Sparklines.SparklineSetting())"
