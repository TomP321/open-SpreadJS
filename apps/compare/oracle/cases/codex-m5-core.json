  {
    "id": "codex-m5-floating-add",
    "steps": [
      {
        "$js": "sheet.floatingObjects.add(new GC.Spread.Sheets.FloatingObjects.FloatingObject('Note',12,20,100,80))"
      }
    ],
    "read": [
      "js:sheet.floatingObjects.all().length",
      "js:sheet.floatingObjects.get('Note') ? sheet.floatingObjects.get('Note').toJSON() : null"
    ]
  },
  {
    "id": "codex-m5-floating-properties",
    "steps": [
      {
        "$js": "const o=new GC.Spread.Sheets.FloatingObjects.FloatingObject('Note',12,20,100,80);sheet.floatingObjects.add(o);o.isLocked(false);o.allowResize(false);o.dynamicMove(false);o.x(50);o.y(60);o.isVisible(false)"
      }
    ],
    "read": [
      "js:sheet.floatingObjects.get('Note') ? sheet.floatingObjects.get('Note').toJSON() : null"
    ]
  },
  {
    "id": "codex-m5-picture-add",
    "steps": [
      {
        "$js": "sheet.pictures.add('Photo','https://example.com/photo.png',10,20,100,80)"
      }
    ],
    "read": [
      "js:sheet.pictures.get('Photo') ? sheet.pictures.get('Photo').toJSON() : null",
      "js:sheet.pictures.zIndex('Photo')"
    ]
