  {
    "id": "codex-m5-sparkline-0",
    "steps": [
      {
        "$js": "sheet.setArray(0,0,[[1],[3],[-2],[5]]); sheet.setSparkline(0,2,new GC.Spread.Sheets.Range(0,0,4,1),0,0,new GC.Spread.Sheets.Sparklines.SparklineSetting())"
      }
    ],
    "read": [
      "js:sheet.getSparkline(0,2)===null",
