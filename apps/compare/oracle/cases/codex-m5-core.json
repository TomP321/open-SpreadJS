  {
    "id": "codex-m5-nested-cellbinding",
    "steps": [
      {
        "$js": "sheet.setBindingPath(1,1,'person.name');sheet.setBindingPath(2,1,'person.age');sheet.setDataSource(new GC.Spread.Sheets.Bindings.CellBindingSource({person:{name:'Alice',age:30}}))"
      },
      {
        "$js": "sheet.setValue(1,1,'Bob')"
      }
    ],
    "read": [
      "js:sheet.getValue(1,1)",
      "js:sheet.getValue(2,1)",
      "js:sheet.getDataSource() ? sheet.getDataSource().getSource() : null"
    ]
  },
  {
    "id": "codex-m5-nested-columnbinding",
    "steps": [
      {
        "$js": "sheet.autoGenerateColumns=false;sheet.bindColumns([{name:'person.name',displayName:'Name'}]);sheet.setDataSource([{person:{name:'Alice'}},{person:{name:'Bob'}}])"
      },
      {
        "$js": "sheet.setValue(1,0,'Carol')"
      }
    ],
    "read": [
      "js:sheet.getArray(0,0,2,1)",
      "js:sheet.getDataSource()"
    ]
  },
