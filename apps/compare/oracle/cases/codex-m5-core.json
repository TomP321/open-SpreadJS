  {
    "id": "codex-m5-context-default",
    "steps": [
      {
        "$js": "wb.contextMenu.menuData.push({name:'test',text:'Custom',workArea:'viewport'});wb.contextMenu.menuView.maxHeight(250);wb.contextMenu.menuView.scrollable(false)"
      }
    ],
    "read": [
      "js:wb.contextMenu.menuData.filter(x=>['gc.spread.copy','gc.spread.cut','gc.spread.sort','test'].includes(x.name))",
      "js:wb.contextMenu.menuView.maxHeight()",
      "js:wb.contextMenu.menuView.scrollable()"
    ]
  },
  {
    "id": "codex-m5-table-binding",
    "steps": [
      {
        "$js": "const T=GC.Spread.Sheets.Tables;const t=sheet.tables.add('People',0,0,2,2);t.bindingPath('rows');sheet.setDataSource(new GC.Spread.Sheets.Bindings.CellBindingSource({rows:[{name:'A',age:30},{name:'B',age:40}]}))"
      },
      {
        "$call": [
          "setValue",
          1,
          1,
          35
        ]
      }
    ],
    "read": [
      "js:sheet.tables.findByName(\"People\") ? sheet.tables.findByName(\"People\").range() : null",
      "js:sheet.getArray(0,0,3,2)",
      "js:sheet.tables.findByName(\"People\") ? sheet.tables.findByName(\"People\").toJSON().columns : null"
    ]
  },
  {
    "id": "codex-m5-status-defaults",
    "read": [
      "js:(()=>{const h=document.createElement('div');document.body.append(h);const bar=new GC.Spread.Sheets.StatusBar.StatusBar(h);const result=bar.all().map(i=>({name:i.name,value:i.value,visible:i.visible,align:i.align,menuContent:i.menuContent}));bar.dispose();h.remove();return result})()"
    ]
  },
  {
    "id": "codex-m5-formula-box-defaults",
    "read": [
      "js:(()=>{const h=document.createElement('div');const box=new GC.Spread.Sheets.FormulaTextBox.FormulaTextBox(h);const result=[box.autoComplete(),box.showHelp(),box.text(),box.workbook()];box.destroy();return result})()"
    ]
  },
  {
    "id": "codex-m5-live-table-calculation",
    "read": [
      "js:sheet.getValue(4,0)"
    ],
    "steps": [
      {
        "$js": "const records=[{amount:2},{amount:4}];const t=sheet.tables.add('BoundValues',0,0,3,1);t.bind([new GC.Spread.Sheets.Tables.TableColumn(1,'amount','Amount')],undefined,records);sheet.setFormula(4,0,'SUM(A2:A3)');sheet._m5Records=records"
      },
      {
        "$js": "sheet._m5Records[0].amount=8;wb.calculate()"
      }
    ]
  }
]
