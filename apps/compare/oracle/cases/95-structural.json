[
 { "id": "struct-insert-rows", "sheets": { "Sheet1": { "A1": 1, "A2": 2, "A3": 3, "B6": "=SUM(A1:A3)", "C6": "=A2*10", "D6": "=$A$3+A1" }, "Sheet2": { "A1": "=Sheet1!A2+1" } },
   "read": ["f:B6", "f:C6", "f:D6", "B6", "f:Sheet2!A1"],
   "steps": [ { "$call": ["addRows", 1, 2] } ] },
 { "id": "struct-insert-rows-read-moved", "sheets": { "Sheet1": { "A1": 1, "A2": 2, "A3": 3, "B6": "=SUM(A1:A3)", "C6": "=A2*10" }, "Sheet2": { "A1": "=Sheet1!A2+1" } },
   "read": ["f:B8", "f:C8", "B8", "C8", "f:Sheet2!A1", "Sheet2!A1"],
   "steps": [ { "$call": ["addRows", 1, 2] }, { "$call": ["deleteRows", 3, 1] } ] },
 { "id": "struct-delete-referenced", "cells": { "A1": 1, "A2": 2, "A3": 3, "B6": "=SUM(A1:A3)", "C6": "=A2*10", "D6": "=A2" },
   "read": ["f:B5", "f:C5", "f:D5", "B5", "C5", "D5"], "steps": [ { "$call": ["deleteRows", 1, 1] } ] },
 { "id": "struct-delete-whole-range", "cells": { "A1": 1, "A2": 2, "B6": "=SUM(A1:A2)" },
   "read": ["f:B4", "B4"], "steps": [ { "$call": ["deleteRows", 0, 2] } ] },
 { "id": "struct-insert-cols", "cells": { "A1": 1, "B1": 2, "C3": "=A1+B1", "D3": "=SUM(A1:B1)", "E3": "=$B$1" },
   "read": ["f:D3", "f:E3", "f:F3", "D3"], "steps": [ { "$call": ["addColumns", 1, 1] } ] },
 { "id": "struct-delete-cols", "cells": { "A1": 1, "B1": 2, "C1": 3, "E3": "=SUM(A1:C1)", "F3": "=B1" },
   "read": ["f:D3", "f:E3", "D3", "E3"], "steps": [ { "$call": ["deleteColumns", 1, 1] } ] },
 { "id": "struct-copy-relative", "cells": { "A1": 1, "A2": 2, "B1": "=A1*2", "C1": "=$A$1+A$1+$A1" },
   "read": ["f:B2", "B2", "f:C2", "f:D1"],
   "steps": [ { "$call": ["copyTo", 0, 1, 1, 1, 1, 1, "$enum:CopyToOptions.all"] }, { "$call": ["copyTo", 0, 2, 1, 2, 1, 1, "$enum:CopyToOptions.all"] }, { "$call": ["copyTo", 0, 2, 0, 3, 1, 1, "$enum:CopyToOptions.all"] } ] },
 { "id": "struct-move", "cells": { "A1": 5, "B1": "=A1+1", "C1": "=B1*2" },
   "read": ["f:C1", "C1", "f:B3", "B3"], "steps": [ { "$call": ["moveTo", 0, 1, 2, 1, 1, 1, "$enum:CopyToOptions.all"] } ] },
 { "id": "struct-rename-sheet", "sheets": { "Sheet1": { "A1": 7 }, "Sheet2": { "A1": "=Sheet1!A1*2" } },
   "read": ["f:Sheet2!A1", "Sheet2!A1"], "steps": [ { "$call": ["name", "My Data"], "$sheet": "Sheet1" } ] },
 { "id": "struct-remove-sheet", "sheets": { "Sheet1": { "A1": "=Sheet2!A1*2" }, "Sheet2": { "A1": 7 } },
   "read": ["f:A1", "A1"], "steps": [ { "$wb": ["removeSheet", 1] } ] },
 { "id": "struct-insert-inside-range", "cells": { "A1": 1, "A2": 2, "A3": 3, "B1": "=SUM(A1:A3)" },
   "read": ["f:B1", "B1"], "steps": [ { "$call": ["addRows", 1, 1] }, { "A2": 100 } ] },
 { "id": "struct-insert-above-whole-col", "cells": { "A1": 1, "B1": "=SUM(A:A)", "C1": "=SUM(1:2)" },
   "read": ["f:B2", "f:C2"], "steps": [ { "$call": ["addRows", 0, 1] } ] },
 { "id": "struct-r1c1-after-insert", "cells": { "A1": 1, "A2": "=A1+1" },
   "read": ["f:A3"], "steps": [ { "$call": ["addRows", 0, 1] } ] },
 { "id": "struct-dynamic-after-insert", "options": { "allowDynamicArray": true }, "cells": { "A1": "=SEQUENCE(3)", "C1": "=SUM(A1#)" },
   "read": ["f:C2", "C2", "A2:A4"], "steps": [ { "$call": ["addRows", 0, 1] } ] },
 { "id": "struct-clear-precedent", "cells": { "A1": 5, "B1": "=A1*2" },
   "read": ["B1"], "steps": [ { "$call": ["clear", 0, 0, 1, 1, "$enum:SheetArea.viewport", "$enum:StorageType.data"] } ] },
 { "id": "struct-suspend-calc", "cells": { "A1": 5, "B1": "=A1*2" },
   "read": ["B1"], "steps": [ { "$wb": ["suspendCalcService", false] }, { "A1": 7 }, { "$wb": ["resumeCalcService", true] } ] }
]
