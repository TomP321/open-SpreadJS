{
  "name": "@opensheets/spread-sheets-io",
  "version": "0.1.0",
  "description": "OpenSheets import/export (IO) plugin for the spreadsheet workbook, drop-in for the SpreadJS IO plugin.",
  "type": "module",
  "main": "./dist/gc.spread.sheets.io.cjs",
  "module": "./dist/gc.spread.sheets.io.esm.js",
  "types": "./dist/gc.spread.sheets.io.d.ts",
  "license": "MIT",
  "sideEffects": true,
  "keywords": [
    "spread-sheets-io",
    "opensheets-io",
    "javascript spreadsheet",
    "javascript excel",
    "io",
    "spread",
    "sheet",
    "javascript",
    "excel",
    "opensheets"
  ],
  "author": {
    "name": "OpenSheets contributors"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/gc.spread.sheets.io.d.ts",
        "default": "./dist/gc.spread.sheets.io.esm.js"
      },
      "require": {
        "types": "./dist/gc.spread.sheets.io.d.cts",
        "default": "./dist/gc.spread.sheets.io.cjs"
      }
    },
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE.md",
    "README.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "tsup && tsx scripts/finalize.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --testTimeout=30000",
    "bench": "tsx bench/large.ts",
    "prepack": "node ../compat/scripts/publish-workspace-specs.mjs prepack",
    "postpack": "node ../compat/scripts/publish-workspace-specs.mjs postpack"
  },
  "dependencies": {
    "@noble/ciphers": "1.3.0",
    "@noble/hashes": "1.8.0",
    "fflate": "0.8.2"
  },
  "peerDependencies": {
    "@mescius/spread-sheets": "*"
  },
  "devDependencies": {
    "@mescius/spread-sheets": "workspace:@opensheets/spread-sheets@*"
  }
}
